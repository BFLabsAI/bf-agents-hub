# ─────────────────────────────────────────────────────────────
# agno-waba-template — environment variables
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────

# ── Client API ────────────────────────────────────────────────
# Base URL of the backend REST API your agent will call.
# Replace with the actual URL of your API service.
CLIENT_API_BASE_URL=https://api.yourdomain.com

# Tenant / client identifier used when calling the API (if applicable).
CLIENT_NAME=default

# Environment suffix appended to API paths (e.g. ".stg" for staging, leave empty for prod).
CLIENT_ENV=

# Set to "false" if the API uses a self-signed or mismatched TLS certificate.
CLIENT_SSL_VERIFY=true

# ── LLM via OpenRouter ────────────────────────────────────────
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Any model ID listed at https://openrouter.ai/models
# Examples: "anthropic/claude-3-haiku", "openai/gpt-4o-mini", "x-ai/grok-3-fast"
OPENROUTER_MODEL_ID=anthropic/claude-3-haiku

# ── Database & Session storage (PostgreSQL) ───────────────────
# URL de conexão Postgres (usada pelo Agno PostgresDb e pelo pool psycopg2).
DATABASE_URL=postgresql://user:password@localhost:5432/whatsapp_waba
DB_SCHEMA=public
DB_POOL_MIN=1
DB_POOL_MAX=10

# ── Meta WhatsApp Business API (WABA) ────────────────────────
# Phone Number ID — found in Meta Developer Console > WhatsApp > API Setup.
WABA_PHONE_NUMBER_ID=

# Permanent or temporary access token from Meta Developer Console.
WABA_ACCESS_TOKEN=

# A secret string you choose; must match what you configure in the Meta webhook settings.
WABA_WEBHOOK_VERIFY_TOKEN=

# App Secret from Meta Developer Console > App Settings > Basic.
# Used to verify HMAC-SHA256 webhook signatures.
WABA_APP_SECRET=

# ── Payment webhook ───────────────────────────────────────────
# Shared secret for the POST /webhooks/payment-confirmed endpoint.
# Leave empty to disable authentication (development only).
PAYMENT_WEBHOOK_SECRET=

# ── Public base URL ───────────────────────────────────────────
# Publicly reachable URL where this service is hosted.
# Used to build links sent to users (e.g. images, receipts).
PUBLIC_BASE_URL=https://yourdomain.com/agent
