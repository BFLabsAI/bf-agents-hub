# SDR Template — environment configuration.
# Copy to .env and fill in. SECRETS LIVE HERE, NEVER IN CODE.
# (GHL_PIT, UAZAPI_TOKEN, S3 keys, NINEROUTER_API_KEY, etc. — env only.)

# --- App ---
DATABASE_URL=postgresql+psycopg_async://user:password@localhost:5432/sdr_template
# Plain psycopg DSN for cron DB connections (optional; derived from DATABASE_URL).
DATABASE_URL_PSYCOPG=postgresql://user:password@localhost:5432/sdr_template
PORT=7780
SLUG=sdr                                     # webhook path + session/user id prefix
TABLE_PREFIX=                                # "" in production
# Background workers (set to 0 to disable dispatcher loop + daily scheduler).
SDR_START_BACKGROUND=1
DISPATCH_INTERVAL_SECONDS=30
BUFFER_WINDOW_SECONDS=8
# Register the uazapi webhook (APPEND-only) on startup — off by default.
SDR_REGISTER_WEBHOOK=0
WEBHOOK_URL=https://your-public-host/sdr/webhook

# --- LLM Gateway (9Router ou qualquer API compatível com OpenAI) ---
# Configure a URL do 9Router (ex: http://localhost:20128/v1 ou URL pública/túnel)
# Se não quiser usar 9Router, pode apontar para qualquer API OpenAI-compatible (OpenRouter, Groq, OpenAI, Ollama).
NINEROUTER_BASE_URL=
NINEROUTER_API_KEY=
AGNO_DEFAULT_MODEL=openai/gpt-4o-mini
AGNO_MULTIMODAL_MODEL=mimo/mimo-v2.5

# --- WhatsApp channel (uazapi) ---
UAZAPI_BASE=https://your-uazapi-host
UAZAPI_TOKEN=                               # secret
UAZAPI_INSTANCE=

# --- CRM (GoHighLevel) ---
GHL_PIT=                                     # secret (Private Integration Token)
GHL_LOCATION_ID=
GHL_PIPELINE_ID=
# GHL_BASE_URL=https://services.leadconnectorhq.com

# --- Media storage (S3-compatible) ---
S3_ENDPOINT=
S3_ACCESS_KEY=                               # secret
S3_SECRET_KEY=                               # secret
S3_BUCKET=

# --- Handoff (repasse) ---
NOTIFICATION_GROUP_JID=                      # WhatsApp group JID for notifications
VENDOR_PHONE=                                # single assigned vendor's number
